# Copy this file to .env.local for local development, and set the same
# keys (minus NEXT_PUBLIC_ where noted) as Vercel Environment Variables
# for deployment. See README.md for the full setup walkthrough.

# ---------------------------------------------------------------------------
# Supabase (Project Settings > API)
# ---------------------------------------------------------------------------
# The project URL is not secret and can be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Server-only. This bypasses Row Level Security — never expose it with a
# NEXT_PUBLIC_ prefix, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App / session security
# ---------------------------------------------------------------------------
# Long random string used to sign partner/admin session tokens.
# Generate one with: openssl rand -hex 32
APP_SECRET=

# Preferred: a bcrypt hash of your admin password (generate with e.g.
# `node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"`).
ADMIN_PASSWORD_HASH=

# Fallback if you don't want to pre-hash it yourself — plaintext compare,
# server-side only. Set ADMIN_PASSWORD_HASH instead when possible.
# ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Google Ad Manager
# ---------------------------------------------------------------------------
# Full service account JSON key, as a single-line JSON string. Create in
# Google Cloud Console > IAM & Admin > Service Accounts, then grant it
# access in Ad Manager under Admin > Access & authorization > Users.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional overrides
# GAM_API_VERSION=v202408
# GAM_APPLICATION_NAME=AdStreamHQ

# ---------------------------------------------------------------------------
# Cron security
# ---------------------------------------------------------------------------
# Required for /api/cron/hourly and /api/cron/daily to run. Vercel Cron
# automatically sends this as `Authorization: Bearer <CRON_SECRET>` when
# it's set — see README.md.
CRON_SECRET=
